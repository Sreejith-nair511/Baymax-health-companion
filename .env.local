# Mistral AI API Key
# Get your API key from https://console.mistral.ai/
MISTRAL_API_KEY=L1Jnjozk76gUwpy2ZPqZgH8wXuK5biZr

# Email Configuration (for sending welcome emails, etc.)
# For Gmail, use:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password (use App Password, not your regular password)
#
# For other email providers, check their SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Database Configuration
# Set to 'false' to disable database and use temporary storage
ENABLE_DATABASE=false

# Development Settings
NODE_ENV=development